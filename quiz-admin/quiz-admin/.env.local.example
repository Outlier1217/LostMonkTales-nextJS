# PostgreSQL connection string for a local/development database
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5433/lost_monk_tales
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
FILE_SERVER_INTERNAL_URL=http://127.0.0.1:3021
FILE_SERVER_PUBLIC_URL=http://127.0.0.1:3021
COURSE_FILE_STORAGE_DIR=/var/lib/lost-monk-tales/course-resources
COURSE_MAX_FILE_SIZE_BYTES=104857600
COURSE_STORAGE_QUOTA_BYTES=0
