generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BookmarkType {
  QUIZ
  BLOG
  ARTWORK
}

enum CourseAccessType {
  FREE
  PAID
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  TEXT
  YOUTUBE
  RESOURCE
}

enum ResourceAccess {
  PUBLIC
  ENROLLED
}

enum EnrollmentSource {
  PURCHASE
  ADMIN_GRANT
}

enum OrderStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

model Quiz {
  id              String        @id @default(cuid())
  title           String
  description     String?
  difficulty      Difficulty    @default(MEDIUM)
  category        String
  topic           String
  timeLimit       Int // in minutes, 0 = no limit
  negativeMarking Boolean       @default(false)
  negativePenalty Float         @default(0.25) // fraction deducted per wrong answer
  passingPercent  Float         @default(60.0)
  isPublished     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]
  bookmarks       Bookmark[]
  attempts        QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  options       Json // Array of { id: string, text: string }
  correctAnswer String // option id
  explanation   String?
  marks         Float    @default(1.0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([quizId])
  @@map("questions")
}

model Blog {
  id           String     @id @default(cuid())
  title        String
  category     String
  topic        String
  content      String // markdown/rich text
  thumbnailUrl String?
  youtubeUrl   String?
  isPublished  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookmarks    Bookmark[]

  @@map("blogs")
}

model User {
  id           String              @id @default(cuid())
  email        String?             @unique
  phone        String?             @unique
  passwordHash String
  image        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  bookmarks    Bookmark[]
  quizAttempts QuizAttempt[]
  enrollments  CourseEnrollment[]
  courseOrders CourseOrder[]
  accessGrants CourseAccessGrant[] @relation("GrantedUser")
  grantsMade   CourseAccessGrant[] @relation("GrantingAdmin")

  @@map("users")
}

model AboutPage {
  id                 String        @id @default(cuid())
  title              String        @default("About Lost Monk Tales")
  tagline            String        @default("Beyond Belief. Toward Understanding.")
  introduction       String        @default("")
  whatWeDo           String        @default("")
  quizzesCourses     String        @default("")
  studioVision       String        @default("")
  philosophy         String        @default("")
  closing            String        @default("")
  founderName        String        @default("Ar. Sumit K. Pahil")
  founderDesignation String        @default("Founder, Lost Monk Tales · Studio LM")
  founderBio         String        @default("")
  founderImage       String?
  updatedAt          DateTime      @updatedAt
  people             AboutPerson[]

  @@map("about_pages")
}

model AboutPerson {
  id          String    @id @default(cuid())
  aboutPageId String
  name        String
  designation String
  bio         String?
  image       String?
  kind        String    @default("TEAM")
  sortOrder   Int       @default(0)
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId, kind, sortOrder])
  @@map("about_people")
}

model Course {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  shortDescription String?
  description      String?
  thumbnailUrl     String?
  category         String?
  subject          String?
  difficulty       Difficulty          @default(MEDIUM)
  instructor       String?
  learningOutcomes Json?
  prerequisites    Json?
  language         String              @default("English")
  durationMinutes  Int?
  accessType       CourseAccessType    @default(FREE)
  price            Float?
  currency         String              @default("INR")
  status           CourseStatus        @default(DRAFT)
  isFeatured       Boolean             @default(false)
  featuredOrder    Int                 @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sections         CourseSection[]
  resources        CourseResource[]
  enrollments      CourseEnrollment[]
  orders           CourseOrder[]
  accessGrants     CourseAccessGrant[]

  @@index([status, isFeatured, featuredOrder])
  @@index([category])
  @@map("courses")
}

model CourseSection {
  id       String         @id @default(cuid())
  courseId String
  title    String
  order    Int            @default(0)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  CourseLesson[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_sections")
}

model CourseLesson {
  id              String           @id @default(cuid())
  sectionId       String
  title           String
  slug            String
  summary         String?
  content         String?
  type            LessonType       @default(TEXT)
  youtubeUrl      String?
  isPreview       Boolean          @default(false)
  isPublished     Boolean          @default(false)
  durationMinutes Int?
  order           Int              @default(0)
  section         CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources       CourseResource[]

  @@unique([sectionId, slug])
  @@unique([sectionId, order])
  @@index([sectionId])
  @@map("course_lessons")
}

model CourseResource {
  id           String         @id @default(cuid())
  courseId     String
  lessonId     String?
  originalName String
  storageKey   String         @unique
  mimeType     String
  extension    String
  size         Int
  access       ResourceAccess @default(ENROLLED)
  uploadedBy   String
  createdAt    DateTime       @default(now())
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       CourseLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId, lessonId])
  @@map("course_resources")
}

model CourseEnrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  source    EnrollmentSource
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseOrder {
  id                String      @id @default(cuid())
  userId            String
  courseId          String
  amount            Float
  currency          String
  status            OrderStatus @default(PENDING)
  provider          String?
  providerReference String?
  createdAt         DateTime    @default(now())
  verifiedAt        DateTime?
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([provider, providerReference])
  @@index([userId, courseId])
  @@map("course_orders")
}

model CourseAccessGrant {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  grantedById String?
  reason      String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("GrantedUser", fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("GrantingAdmin", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId, courseId])
  @@map("course_access_grants")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

model ArtCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  artworks    Artwork[]

  @@map("art_categories")
}

model Artwork {
  id          String      @id @default(cuid())
  title       String
  description String?
  price       Float
  contact     String // WhatsApp number / email / link
  images      Json // String[] — array of image URLs
  categoryId  String
  category    ArtCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookmarks   Bookmark[]

  @@index([categoryId])
  @@map("artworks")
}

enum PortraitCategory {
  PENCIL_PORTRAITS
  PAINTING
  OIL_ACRYLIC_PORTRAITS
}

model Portrait {
  id          String           @id @default(cuid())
  title       String
  image       String
  category    PortraitCategory
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@map("portraits")
}

enum ArchitectureCategory {
  INTERIOR
  COMMERCIAL
  RESIDENTIAL
}

model ArchitectureProject {
  id          String               @id @default(cuid())
  title       String
  description String?
  location    String?
  size        String?
  price       String?
  category    ArchitectureCategory
  images      Json
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category])
  @@map("architecture_projects")
}

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  type      BookmarkType
  quizId    String?
  blogId    String?
  artworkId String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz      Quiz?        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  blog      Blog?        @relation(fields: [blogId], references: [id], onDelete: Cascade)
  artwork   Artwork?     @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@unique([userId, blogId])
  @@unique([userId, artworkId])
  @@index([userId, type])
  @@map("bookmarks")
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String
  score      Float
  totalMarks Float
  percentage Float
  correct    Int
  wrong      Int
  skipped    Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([quizId])
  @@map("quiz_attempts")
}
